funciones de cadena 

FUNCION 

CONCAT       concatena dos o mas cadenas                 SELECT CONCAT('HOLA', '', 'Mundo')     'Hola Mundo'
UPPER        convierte una cadena a mayusculas
LOWER        convierte una cadea a minusculas
SUBSTRING    extrae una subcadena
LENGTH       devuelve la longitud de una cadena
TRIM         elimina espacio al inicio y al final

ABS          devuelve el valor absoluto                  SELECT ABS(-25);                           25
ROUND        redondea un numero                          SELECT ROUND(15.678, 2)                    15.68
CEIL         redondea hacia arriba al entero mas cercano SELECT CEIL(12.34)                         13
FLOOR        redondea hacia abajo al entero mas cercano  SELECT FLOOR(12.98)                        12
MOD          devuelve el resto de una division           SELECT MOD(10, 3);                         1
POWER        Eleva un número a una potencia              SELECT POWER(2,3);                         8


NOW          Devuelve la fecha y la hora actual          SELECT NOW();                           22-10-2026 12:10
CURDATE      devuelve la fecha actual                    SELECT CURDATE();                       22-10-2025
YEAR         EXTRAE EL AÑO DE UNA FECHA                  SELECT YEAR();
MONTH        EXTRAE EL MES DE UNA FECHA                  SELECT MONTH();
DAY          EXTRAE EL DIA DE UNA FECHA                  SELECT DAY();
DATEDIFF     CALCULA LAD DIFERENCIA EN DIA ENTRE DOS FECHA SELECT DATEDIFF('2025-02-04', '2026-05-21')




CAST        convierte un valor a un tipo de dato diferente SELECT CAST('123' AS UNSIGNED);       123 (como numero)
CAST        convierte un valor numero a una cadena         SELECT CAST(123 AS CHAR);